from abc import ABC,abstractmethod


# ==========================================================
# 1. ABSTRACT BASE CLASS
# ==========================================================
class Students(ABC):
    
    # Encapsulation - Private Attributes
    def __init__(self, Name, Roll_No, Marks):
        self.__Name = Name
        self.__Roll_No = Roll_No
        self.__Marks = Marks
        
    # ---------------- DISPLAY ----------------
    def display(self):
        
        print("Roll_No:", self.__Roll_No)
        print("Name:", self.__Name)
        print("Marks:", self.__Marks)

    # ---------------- GETTERS ----------------
    def get_Name(self): 
        return self.__Name
        
    def get_Roll_No(self):
        
        return self.__Roll_No
    def get_Marks(self):
        
        return self.__Marks

    # ---------------- SETTER ----------------
    def set_Marks(self,Marks):
        self.__Marks=Marks
        
    def set_Name(self,Name):
        self.__Name=Name

    # Abstraction  
    @abstractmethod
    def student_section(self):
        pass

# ==========================================================
# 2. DERIVED CLASS - INHERITANCE
# ==========================================================        
class Section(Students):
    
    def student_section(self): 
        return "DC"
        
# ==========================================================
# 3. STUDENT MANGEMENT SYSTEM CLASS
# ==========================================================
class Student_Management_System:
    
    def __init__(self):
        self.students = []
        
    # ------------------------------------------------------
    # ADD STUDENT
    # ------------------------------------------------------
    def add_student(self):
        
        Roll_No = input("Enter the Roll_No: ")
    
        # Check duplicate Roll No.
        for student in self.students:
            
            if student.get_Roll_No() == Roll_No:
                
                print("Roll Number Already Exists")
                return
                
        Name = input("Enter the Name: ")
        
        try:
            
            Marks = float(input("Enter the Marks: "))
            
            if Marks<0 or Marks>100:
                
                print("Marks Must Be Between 0 And 100..")
                return

        except ValueError:
            
            print("Please Enter Valid Marks")
            return
            
        # Create object of derived class 
        student = Section(Name, Roll_No, Marks)
        
        self.students.append(student)
        
        print("Student Added Successfully")

    # ------------------------------------------------------
    # DISPLAY STUDENTS
    # ------------------------------------------------------    
    def display_student(self):
        
        if len(self.students) == 0:
            print("No record found")
            return

        print("--------Students Records-----------\n")

        for student in self.students:
            student.display()
            print("Section:", student.student_section())
            print("---------------------")
            
    # ------------------------------------------------------
    # SEARCH STUDENTS
    # ------------------------------------------------------
    def search_student(self):
        Roll_No = input("Enter The Roll_No: ")

        for student in self.students:
            
            if student.get_Roll_No() == Roll_No:
                
                print("\nStudent Found")
                student.display()
                return

        print("Student Not Found")
        
    # ------------------------------------------------------
    # UPDATE STUDENT RECORDS
    # ------------------------------------------------------
    def update_student(self):
        
        Roll_No = input("Enter The Roll_No: ")

        for student in self.students:
            
            if student.get_Roll_No() == Roll_No:
                
                try:
                    
                    update_marks = float(input("Enter The Updated Marks: "))
                    
                    if update_marks<0 or update_marks>100:
                        
                        print("Marks Must Be Between 0 And 100..")
                        return
                    
                    student.set_Marks(update_marks)
                    print("Updated Marks:",student.get_Marks())
                    
                except ValueError:
                    
                    print("Please Enter Valid Marks")
                    return
                    
                update_name = input("Enter The Updated Name: ")
                student.set_Name(update_name)
                print("Updated Name:",student.get_Name())
                
                print("Student Record Updated Successfully")
                return

        print("Student Not Found")
        
    # ------------------------------------------------------
    # DELETE STUDENT
    # ------------------------------------------------------
    def delete_student(self):
        
        Roll_No = input("Enter The Roll_No: ")

        for student in self.students:
            
            if student.get_Roll_No() == Roll_No:
                
                self.students.remove(student)

                print("Student Record Deleted Successfully")
                return

        print("Student Not Found")
        
    # ------------------------------------------------------
    # CALCULATE AVERAGE MARKS
    # ------------------------------------------------------
    def average_marks(self):
        
        if len(self.students) == 0:
            
            print("No record found")
            return

        total = 0

        for student in self.students:
            
            total += student.get_Marks()

        average = total / len(self.students)

        print("Average_Marks:", average)
        
    # ------------------------------------------------------
    # SAVE RECORD TO FILE
    # ------------------------------------------------------
    def save_record(self):
        
        try:
            
            with open("student.csv", "w") as st:
                
                for student in self.students:
                    
                    st.write(
                        student.get_Roll_No() + "," +
                        student.get_Name() + "," +
                        str(student.get_Marks()) + "\n"
                    )
    
            print("Record Saved Successfully")
            
        except OSError:
            
            print("Error While Saving File...")
            
    # ------------------------------------------------------
    # LOAD RECORD FROM FILE
    # ------------------------------------------------------        
    def load_record(self):
        
        try:
            
            with open("student.csv",'r') as st:
                
                for line in stu:
                    
                    line=line.strip()
                    
